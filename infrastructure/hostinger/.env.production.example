# ── Domains (point A records to your VPS public IP) ─────────────────────────
APP_DOMAIN=aranyix.tech
API_DOMAIN=api.aranyix.tech
FRONTEND_URL=https://aranyix.tech
# Optional: public MinIO for presigned browser uploads (same IP, Caddy → minio:9000)
MEDIA_DOMAIN=media.byot.earth

# ── Public URLs (used at frontend build time — rebuild after changing) ───────
# Same-origin is most reliable: browser calls https://aranyix.tech/api/... (Caddy proxies to backend).
# Leave empty or set to https://aranyix.tech — the app uses relative /api on aranyix.tech in the browser.
# Do NOT set https://api.aranyix.tech unless CSP connect-src includes the API subdomain (see Caddyfile).
NEXT_PUBLIC_API_URL=
CORS_ORIGINS=https://aranyix.tech,https://www.aranyix.tech

# ── Redis (internal broker + cache) ─────────────────────────────────────────
# Use hex-only password (openssl rand -hex 32) — avoids URL-encoding issues in REDIS_URL
REDIS_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=byot
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_32
POSTGRES_DB=byot

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32
# HMAC for signed HttpOnly byot_session cookie (frontend middleware). Required in production.
SESSION_COOKIE_SECRET=CHANGE_ME_use_openssl_rand_hex_32
# Evidence bundle signing (separate from JWT — do not reuse JWT_SECRET in production)
EVIDENCE_SIGNING_KEY=CHANGE_ME_use_openssl_rand_hex_32
GOOGLE_REDIRECT_URI=https://aranyix.tech/api/v1/auth/google/callback

# ── MinIO (internal S3-compatible storage) ───────────────────────────────────
MINIO_ROOT_USER=byotadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
S3_BUCKET_MEDIA=byot-media
# Browser-reachable MinIO URL for presigned photo/audio uploads (Caddy proxies /media → minio:9000)
S3_PUBLIC_ENDPOINT_URL=https://aranyix.tech/media

# ── Google Maps (frontend build arg) ────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── CAPTCHA (Cloudflare Turnstile) ─────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Google OAuth (backend) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Authorized redirect URI in Google Cloud Console exactly:
# https://api.aranyix.tech/api/v1/auth/google/callback

# ── Satellite (Copernicus Data Space) ───────────────────────────────────────
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_API_URL=https://sh.dataspace.copernicus.eu
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# ── SAR / live ground intelligence ───────────────────────────────────────────
# SAR_PROVIDER: stub | gee | sentinel_hub
#   gee          — Google Earth Engine Sentinel-1 (GEE_SERVICE_ACCOUNT_JSON)
#   sentinel_hub — Copernicus Data Space Sentinel-1 (reuses SENTINEL_HUB_* below)
SAR_PROVIDER=stub
SAR_ENABLED=true
GEE_SA_JSON_HOST=/opt/aranyix/secrets/gee-service-account.json
GEE_SERVICE_ACCOUNT_JSON=/run/secrets/gee-sa.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gee-sa.json

# ── AI (optional) ───────────────────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── BYOT AI scan packs (Razorpay — BYOT citizens only) ───────────────────────
# Get test keys from https://dashboard.razorpay.com/app/keys
# NEVER commit real secrets to git — set only in .env.production on the VPS
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: webhook signing secret from Razorpay Dashboard → Webhooks
RAZORPAY_WEBHOOK_SECRET=
# Public key for frontend (same as RAZORPAY_KEY_ID); optional if using /payments/catalog API
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ── Bioacoustic (BirdNET + GBIF + IUCN) ─────────────────────────────────────
# Default deploy uses a slim worker (no TensorFlow). Enable ML only when needed:
#   COMPOSE_PROFILES=bioacoustic ./deploy.sh
# Then run download-perch-model.sh if using Perch v2.
BIOACOUSTIC_PIPELINE=birdnet
BIOACOUSTIC_MIN_CONFIDENCE=0.15
BIOACOUSTIC_RETURN_ALL_DETECTIONS=true
BIOACOUSTIC_NOISE_REDUCTION=false
BIOACOUSTIC_ENABLE_FROGS=false
BIOACOUSTIC_ENABLE_INSECTS=false
# Perch v2 multi-taxa (amphibians, mammals, insects, reptiles) — run download-perch-model.sh first
BIOACOUSTIC_ENABLE_PERCH=false
BIOACOUSTIC_PERCH_MODEL_PATH=/opt/aranyix/models/perch_v2_no_dft.onnx
BIOACOUSTIC_PERCH_LABELS_PATH=/opt/aranyix/models/perch_labels.txt
BIOACOUSTIC_PERCH_MIN_CONFIDENCE=0.20
BIOACOUSTIC_PERCH_TAXA=amphibian,mammal,insect,reptile
BIOACOUSTIC_REVIEW_CONFIDENCE=0.70
# PERCH_MODEL_HOST_DIR=/opt/aranyix/models
IUCN_API_TOKEN=
IUCN_API_URL=https://api.iucnredlist.org/api/v4
GBIF_API_URL=https://api.gbif.org/v1
GBIF_OCCURRENCE_RADIUS_KM=25

# ── ISRO Bhoonidhi (optional — IRS / ResourceSat catalog) ───────────────────
# Register VPS public IPv4 with bhoonidhi@nrsc.gov.in before enabling
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=
BHOONIDHI_API_URL=https://bhoonidhi-api.nrsc.gov.in

# ── OTP (Phase 5) ───────────────────────────────────────────────────────────
# Phone OTP: MSG91 SendOTP — set AUTH_OTP_SMS_ENABLED=true when wired
AUTH_OTP_SMS_ENABLED=false
# NEVER enable in production/staging — blocks boot if true
AUTH_ALLOW_DEV_OTP=false
# Public API docs + Prometheus metrics (keep false on internet-facing API)
EXPOSE_API_DOCS=false
EXPOSE_METRICS=false
# Email OTP: Gmail API + Google Workspace domain delegation
AUTH_OTP_EMAIL_ENABLED=false
# Org invite SMS/email — independent toggles for team onboarding
AUTH_ORG_INVITE_SMS_ENABLED=false
AUTH_ORG_INVITE_EMAIL_ENABLED=false
# Professional program access queue (uses same Gmail service account as OTP/invites)
AUTH_PROGRAM_ACCESS_EMAIL_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ARANYX
MSG91_OTP_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE_ID=
GMAIL_SENDER=no-reply@aranyix.tech
# Host path to service-account JSON (chmod 600) — mounted read-only into API/workers
GMAIL_SA_JSON_HOST=/opt/aranyix/secrets/gmail-service-account.json
# In-container path is fixed by docker-compose (/run/secrets/gmail-sa.json)

# ── Notifications (optional — alerts; email OTP uses Gmail above) ───────────
SES_SENDER=no-reply@aranyix.tech
SNS_SMS_SENDER_ID=BYOT
FCM_SERVER_KEY=

# ── AWS region (used by notifier SDK if you add SES/SNS later) ────────────────
AWS_REGION=ap-south-1
