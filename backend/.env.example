APP_ENV=development
APP_NAME=byot-api
APP_VERSION=1.0.0
APP_DEBUG=true

# Postgres + PostGIS
DATABASE_URL=postgresql+asyncpg://byot:byot@postgres:5432/byot
DATABASE_URL_SYNC=postgresql+psycopg2://byot:byot@postgres:5432/byot

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-prod-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3000

# AWS / S3
AWS_REGION=ap-south-1
S3_BUCKET_MEDIA=byot-media-local
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=byotadmin
AWS_SECRET_ACCESS_KEY=byotadmin123

# AI providers (optional in dev; service falls back to stub)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Razorpay — BYOT AI scan packs (optional; checkout hidden when unset)
# When keys are set in staging/production, RAZORPAY_WEBHOOK_SECRET is required (dedicated secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BYOT_FREE_AI_SCANS=5

# Satellite providers (optional in dev; service falls back to stub)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_API_URL=https://sh.dataspace.copernicus.eu
SENTINEL_HUB_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
GEE_SERVICE_ACCOUNT_JSON=

# SAR ground intelligence (NISAR-inspired; live via GEE or Copernicus Sentinel Hub)
SAR_PROVIDER=stub
SAR_ENABLED=true

# Weather (Open-Meteo — free, no API key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
# Copernicus CDS — free ERA5 for GHG dispersion met (register at cds.climate.copernicus.eu)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
EMISSION_SATELLITE_BUFFER_KM=25

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# CAPTCHA (Cloudflare Turnstile) — required in staging/production; enables login/register guards
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OTP — SMS via MSG91; auth email OTP via Amazon SES
AUTH_OTP_SMS_ENABLED=false
# Dev only: accept OTP 000000 and return codes in API responses (never in production)
AUTH_ALLOW_DEV_OTP=true
EXPOSE_API_DOCS=true
EXPOSE_METRICS=true
AUTH_OTP_EMAIL_ENABLED=false
# Org invite notifications (Gmail API — optional; separate from auth email OTP)
AUTH_ORG_INVITE_SMS_ENABLED=false
AUTH_ORG_INVITE_EMAIL_ENABLED=false
# Professional program access queue (Gmail API when enabled)
AUTH_PROGRAM_ACCESS_EMAIL_ENABLED=false
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ARANYX
MSG91_OTP_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE_ID=
# Auth email OTP (Resend) — verify domain aranyix.tech in Resend dashboard
AUTH_OTP_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@aranyix.tech
RESEND_FROM_NAME=Aranyix
# Legacy SES sender (rollback only)
SES_SENDER=no-reply@aranyix.tech
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Org invites / program access (Resend preferred; Gmail API legacy fallback)
GMAIL_SENDER=no-reply@aranyix.tech
# Path to service-account JSON file, or inline JSON (never commit secrets)
GOOGLE_SERVICE_ACCOUNT_JSON=
SNS_SMS_SENDER_ID=BYOT
FCM_SERVER_KEY=

# Bioacoustic — BirdNET bird identification (production default)
BIOACOUSTIC_PIPELINE=birdnet
BIOACOUSTIC_MIN_CONFIDENCE=0.15
BIOACOUSTIC_RETURN_ALL_DETECTIONS=true
BIOACOUSTIC_NOISE_REDUCTION=false
BIOACOUSTIC_ENABLE_FROGS=false
BIOACOUSTIC_ENABLE_INSECTS=false
BIOACOUSTIC_ENABLE_PERCH=false
BIOACOUSTIC_PERCH_MODEL_PATH=/opt/aranyix/models/perch_v2_no_dft.onnx
BIOACOUSTIC_PERCH_LABELS_PATH=/opt/aranyix/models/perch_labels.txt
BIOACOUSTIC_PERCH_MIN_CONFIDENCE=0.20
BIOACOUSTIC_PERCH_TAXA=amphibian,mammal,insect,reptile
IUCN_API_TOKEN=

# ISRO Bhoonidhi STAC catalog (register VPS IP with bhoonidhi@nrsc.gov.in)
BHOONIDHI_USER_ID=
BHOONIDHI_PASSWORD=
BHOONIDHI_API_URL=https://bhoonidhi-api.nrsc.gov.in

# Evidence bundle signing (Ed25519) — set EVIDENCE_SIGNING_KEY in production (base64 32-byte seed)
EVIDENCE_SIGNING_KEY=
EVIDENCE_TSA_ENABLED=true
EVIDENCE_TSA_URL=
EVIDENCE_TSA_STUB_LABEL=byot-dev-tsa-stub
