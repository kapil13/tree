NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: only needed for direct browser→API calls (omit when using Docker — use /api proxy)
# NEXT_PUBLIC_API_URL=
# Google Maps JavaScript API key (enable Maps JavaScript API in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare Turnstile (login / registration CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sprint A: focused project page (no tab bar; map + trees on one scroll). 0 = legacy tabs.
NEXT_PUBLIC_PROJECT_FOCUSED_UI=0

# HMAC secret for signed HttpOnly byot_session cookie (falls back to NEXTAUTH_SECRET;
# in development only, falls back to "dev-session-secret" if both are unset)
SESSION_COOKIE_SECRET=
# NEXTAUTH_SECRET=
